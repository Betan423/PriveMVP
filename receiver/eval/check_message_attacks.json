      "expected_level": "high",
      "expected_facts": {"asks_transfer": true, "urgency": true},
      "redaction_contains": [],
      "redaction_excludes": []
    },
    {
      "id": "fragment_remains_insufficient",
      "text": "請處理這件事，細節還沒有說明。",
      "expected_level": "insufficient",
      "expected_facts": {"context_sufficient": false},
      "redaction_contains": [],
      "redaction_excludes": []
    },
    {
