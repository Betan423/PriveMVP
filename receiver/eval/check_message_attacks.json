      "expected_level": "high",
      "expected_facts": {"asks_transfer": true, "urgency": true},
      "redaction_contains": [],
      "redaction_excludes": []
    },
    {
      "id": "zero_width_transfer",
      "text": "請立即匯​款到 SYN_ACCOUNT_PRIVATE_ATTACK。",
      "expected_level": "high",
      "expected_facts": {"asks_transfer": true},
      "redaction_contains": ["[ACCOUNT]"],
      "redaction_excludes": ["SYN_ACCOUNT", "​"]
    },
    {
      "id": "spaced_otp_request",
      "text": "請提 供驗 證 碼給我。",
      "expected_level": "high",
      "expected_facts": {"requests_secret": true},
      "redaction_contains": [],
      "redaction_excludes": []
    },
    {
      "id": "zero_width_support_impersonation",
      "text": "我是客⁠服，請提供驗證碼 A7B9C2。",
      "expected_level": "high",
      "expected_facts": {"requests_secret": true, "impersonation": "support"},
      "redaction_contains": ["[OTP]"],
      "redaction_excludes": ["A7B9C2", "⁠"]
    },
    {
      "id": "zero_width_phone",
      "text": "聯絡電話 0912​345678，明天下午見。",
      "expected_level": "verify",
      "expected_facts": {"context_sufficient": true},
      "redaction_contains": ["[PHONE]"],
      "redaction_excludes": ["0912", "345678", "​"]
    },
    {
      "id": "zero_width_url",
      "text": "請查看 https://exa⁠mple.invalid/status 後自行核對來源。",
      "expected_level": "verify",
      "expected_facts": {"has_link": true},
      "redaction_contains": ["[LINK]"],
      "redaction_excludes": ["https://", "example", "⁠"]
    },
    {
      "id": "negated_otp_is_not_request",
      "text": "一次性驗 證 碼 123456，請 勿 告 訴任何人。",
      "expected_level": "verify",
      "expected_facts": {"requests_secret": false},
      "redaction_contains": ["[NUMBER]"],
      "redaction_excludes": ["123456"]
    },
    {
      "id": "negation_does_not_hide_later_transfer",
      "text": "不用付款，請轉 帳給我。",
      "expected_level": "high",
      "expected_facts": {"asks_transfer": true},
      "redaction_contains": [],
      "redaction_excludes": []
