{
  "policy_version": "check-message-privacy-4",
  "packet_schema": "privagent.check_message_packet.v4",
  "client_policy_versions": ["phone-msg-4"],
  "allowed_top_level_fields": [
    "schema",
    "task_id_alias",
    "request_nonce",
    "issued_at_ms",
    "intent",
    "locale",
    "cloud_consent",
    "facts",
    "redacted_excerpt",
    "allowed_sops",
    "client_policy_version"
  ],
  "facts": {
    "asks_transfer": {"type": "boolean", "purpose": "detect payment pressure"},
    "requests_secret": {"type": "boolean", "purpose": "detect credential or OTP requests"},
    "urgency": {"type": "boolean", "purpose": "detect urgency pressure"},
    "has_link": {"type": "boolean", "purpose": "select link verification guidance"},
    "link_kind": {
      "type": "enum",
      "values": ["none", "known_official", "unknown", "shortener", "suspicious"],
      "purpose": "grade link risk from on-device domain classification without disclosing the URL"
    },
    "offers_reward": {"type": "boolean", "purpose": "detect reward or investment pressure"},
    "requests_remote_control": {"type": "boolean", "purpose": "detect remote-control requests"},
    "action_negated": {"type": "boolean", "purpose": "distinguish warnings such as do not transfer from direct requests"},
    "financial_promise": {"type": "boolean", "purpose": "detect guaranteed-return and investment solicitation language"},
    "account_threat": {"type": "boolean", "purpose": "detect account suspension or transaction-failure pressure"},
    "contact_change": {"type": "boolean", "purpose": "detect changed-number and move-to-another-account social engineering"},
    "anti_scam_context": {"type": "boolean", "purpose": "distinguish anti-scam warnings from scam solicitations"},
    "fact_check_context": {"type": "boolean", "purpose": "distinguish news, quotation and fact-check content"},
    "direct_request": {"type": "boolean", "purpose": "record whether the recipient is being asked to act"},
    "context_sufficient": {"type": "boolean", "purpose": "avoid guessing from incomplete content"},
    "impersonation": {
      "type": "enum",
      "values": ["none", "family", "official", "support"],
      "purpose": "select a trusted out-of-band verification path"
    },
    "message_stance": {
      "type": "enum",
      "values": ["direct_request", "warning", "report", "notice", "general", "unknown"],
      "purpose": "separate solicitation from warning, quotation, report and ordinary conversation"
    },
    "requested_action": {
      "type": "enum",
      "values": ["none", "transfer", "share_secret", "open_link", "install_remote", "contact", "multiple"],
      "purpose": "describe the requested action without retaining message text"
    },
    "credential_target": {
      "type": "enum",
      "values": ["none", "otp", "password", "card", "identity", "account", "multiple"],
      "purpose": "retain credential type semantics while removing the credential value"
    },
    "source_kind": {
      "type": "enum",
      "values": ["notification", "pasted"],
      "purpose": "explain whether the user pasted or selected the message"
    }
  },
  "redacted_excerpt": {
    "default": null,
    "max_chars": 300,
    "requires_separate_opt_in": true,
    "forbidden_when_local_risk": "high",
    "retention": "never_store"
  },
  "freshness": {
    "max_age_ms": 300000,
    "max_future_skew_ms": 60000,
    "nonce_cache_entries": 10000
  },
  "retention": {
    "raw_message": "device_memory_only",
    "redacted_excerpt": "not_in_audit",
    "request_nonce": "replay_cache_only",
    "task_alias": "audit_allowed",
    "facts": "audit_field_names_only"
  },
  "forbidden_cloud_values": [
    "phone_number",
    "email",
    "url",
    "national_id",
    "otp_or_password",
    "account_number",
    "known_contact_name",
    "persistent_device_or_user_id"
  ]
}
